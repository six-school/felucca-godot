[configuration]

entry_symbol = "felucca_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://bin/libfelucca.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libfelucca.linux.template_release.x86_64.so"
web.debug.threads.wasm32 = "res://bin/libfelucca.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "res://bin/libfelucca.web.template_release.wasm32.wasm"
